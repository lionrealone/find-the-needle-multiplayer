func locale() -> String:
	var raw := TranslationServer.get_locale()
	if raw == "":
		raw = OS.get_locale_language()
	if raw == "":
		raw = OS.get_locale()
	var l := String(raw)
	if l.length() >= 2:
		l = l.substr(0, 2).to_lower()
	if l == "nb" or l == "nn":
		l = "en"
	return l if STRINGS.has(l) else FALLBACK

func t(key: String) -> String:
	var table: Dictionary = STRINGS.get(locale(), {})
	if table.has(key):
		return table[key]
	return STRINGS[FALLBACK].get(key, key)
